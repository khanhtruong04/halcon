<l>set_drawing_object_params(DrawID, 'color', 'yellow')</l>
<l>dev_display(Image)</l>
<l>dev_set_color('yellow')</l>
<c>* vẽ Region bắng đường bao (dùng fill để lắp đầy region)</c>
<l>dev_set_draw('margin') </l>
<c>* Đưa drawing object lên trên ảnh</c>
<l>attach_drawing_object_to_window (Win1, DrawID)</l>
<c>* (Sau khi người dùng vẽ xong)</c>
<l>detach_drawing_object_from_window (Win1, DrawID)</l>
